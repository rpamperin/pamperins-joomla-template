<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="details">
		<fieldset name="details" label="COM_PTICKETS_FIELDSET_DETAILS">
			<field name="project" type="list" label="COM_PTICKETS_F_SW_PROJECT" required="true" validate="options">
				<option value="">JSELECT</option>
				<option value="custom">COM_PTICKETS_O_SW_CUSTOM</option>
				<option value="mobile">COM_PTICKETS_O_SW_MOBILE</option>
				<option value="desktop">COM_PTICKETS_O_SW_DESKTOP</option>
				<option value="integration">COM_PTICKETS_O_SW_INTEGRATION</option>
				<option value="scripts">COM_PTICKETS_O_SW_SCRIPTS</option>
				<option value="fix">COM_PTICKETS_O_SW_FIX</option>
				<option value="other">COM_PTICKETS_O_OTHER</option>
			</field>
			<field name="platforms" type="checkboxes" label="COM_PTICKETS_F_PLATFORMS">
				<option value="web">COM_PTICKETS_O_PLAT_WEB</option>
				<option value="windows">Windows</option>
				<option value="mac">macOS</option>
				<option value="linux">Linux</option>
				<option value="ios">iPhone / iPad</option>
				<option value="android">Android</option>
			</field>
			<field name="current" type="textarea" rows="2" label="COM_PTICKETS_F_SW_CURRENT" filter="string" />
			<field name="users" type="list" label="COM_PTICKETS_F_SW_USERS" validate="options">
				<option value="me">COM_PTICKETS_O_USERS_ME</option>
				<option value="team">COM_PTICKETS_O_USERS_TEAM</option>
				<option value="customers">COM_PTICKETS_O_USERS_CUSTOMERS</option>
			</field>
			<field name="budget" type="list" label="COM_PTICKETS_F_BUDGET" validate="options">
				<option value="unsure">COM_PTICKETS_O_NOT_SURE</option>
				<option value="lt1k">COM_PTICKETS_O_BUDGET_1</option>
				<option value="1-3k">COM_PTICKETS_O_BUDGET_2</option>
				<option value="3-10k">COM_PTICKETS_O_BUDGET_3</option>
				<option value="10k+">COM_PTICKETS_O_BUDGET_4</option>
			</field>
			<field name="deadline" type="text" label="COM_PTICKETS_F_DEADLINE" filter="string" maxlength="100" />
		</fieldset>
	</fields>
</form>
